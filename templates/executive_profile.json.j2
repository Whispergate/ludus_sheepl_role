{
  "sheepl": {
    "name": "{{ ludus_sheepl_name }}",
    "total_time": "{{ ludus_sheepl_total_time }}",
    "typing_speed": {{ ludus_sheepl_typing_speed }},
    "loop": "{{ 'True' if ludus_sheepl_loop else 'False' }}",
    "icon": "{{ 'True' if ludus_sheepl_tray_icon else 'False' }}",
    "tasks": [
      {
        "task": "Browser",
        "browser": "edge",
        "urls": [
          "{{ ludus_sheepl_intranet_url }}",
          "https://www.bbc.co.uk/news",
          "https://www.linkedin.com"
        ]
      },
      {
        "task": "WordDocument",
        "input_file": "content/if.txt",
        "save_name": {{ ("c:\\users\\" ~ ludus_sheepl_name ~ "\\Documents\\board-memo.doc") | tojson }}
      },
      {
        "task": "RunCommand",
        "cmd": ["calc"]
      },
      {
        "task": "Browser",
        "browser": "edge",
        "urls": ["https://outlook.office.com"]
      },
      {
        "task": "VLC",
        "media": "https://archive.org/download/webinar/q3-briefing.mp4"
      }
    ]
  }
}
