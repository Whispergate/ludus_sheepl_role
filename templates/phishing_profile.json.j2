{
  "sheepl": {
    "name": "{{ ludus_sheepl_name }}",
    "total_time": "{{ ludus_sheepl_total_time }}",
    "typing_speed": {{ ludus_sheepl_typing_speed }},
    "loop": "{{ 'True' if ludus_sheepl_loop else 'False' }}",
    "icon": "{{ 'True' if ludus_sheepl_tray_icon else 'False' }}",
    "tasks": [
      {
        "task": "Browser",
        "browser": "edge",
        "urls": ["{{ ludus_sheepl_mail_url | default('') }}"]
      },
      {
        "task": "CommandShell",
        "cmd": [
          "powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File C:/ProgramData/Sheepl/fetch_mail_attachment.ps1 -MailServerUrl '{{ ludus_sheepl_mail_url | default('') }}'"
        ]
      },
      {
        "task": "Browser",
        "browser": "edge",
        "urls": ["{{ ludus_sheepl_intranet_url | default('') }}"]
      }
    ]
  }
}
