{
  "sheepl": {
    "name": "{{ ludus_sheepl_name }}",
    "total_time": "{{ ludus_sheepl_total_time }}",
    "typing_speed": {{ ludus_sheepl_typing_speed }},
    "loop": "{{ 'True' if ludus_sheepl_loop else 'False' }}",
    "icon": "{{ 'True' if ludus_sheepl_tray_icon else 'False' }}",
    "tasks": [
      {
        "task": "CommandShell",
        "cmd": [
          "ipconfig /all",
          "whoami /groups",
          "netstat -anto"
        ]
      },
      {
        "task": "PowerShell",
        "cmd": [
          "Get-WmiObject Win32_Service | Select-Object Name,State,StartMode",
          "$PSVersionTable"
        ]
      },
      {
        "task": "WordDocument",
        "input_file": "content/if.txt",
        "save_name": {{ ("c:\\users\\" ~ ludus_sheepl_name ~ "\\Documents\\maintenance-log.doc") | tojson }}
      },
      {
        "task": "PuttyConnection",
        "computer": {{ ludus_sheepl_ssh_target | tojson }},
        "username": {{ ludus_sheepl_ssh_user | tojson }},
        "password": {{ ludus_sheepl_ssh_password | tojson }},
        "cmd": [
          "ifconfig",
          "uname -a",
          "systemctl status"
        ]
      },
      {
        "task": "Clipboard",
        "items": [
          "ticket #4471 - PLC offline",
          "asset tag: RTU-00912"
        ]
      },
      {
        "task": "LibreOfficeCalc",
        "save_name": {{ ("c:\\users\\" ~ ludus_sheepl_name ~ "\\Documents\\asset-audit.ods") | tojson }},
        "rows": [
          ["Asset", "Location", "Status"],
          ["RTU-00912", "pumphouse-3", "in repair"],
          ["PLC-00455", "substation-a", "active"]
        ]
      }
    ]
  }
}
