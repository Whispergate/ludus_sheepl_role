{
  "sheepl": {
    "name": "{{ ludus_sheepl_name }}",
    "total_time": "{{ ludus_sheepl_total_time }}",
    "typing_speed": {{ ludus_sheepl_typing_speed }},
    "loop": "{{ 'True' if ludus_sheepl_loop else 'False' }}",
    "icon": "{{ 'True' if ludus_sheepl_tray_icon else 'False' }}",
    "tasks": [
      {
        "task": "RunCommand",
        "cmd": [
          "\\\\{{ ludus_sheepl_bad_host }}"
        ]
      },
      {
        "task": "CommandShell",
        "cmd": [
          "net view \\\\{{ ludus_sheepl_bad_host }}",
          "net use \\\\{{ ludus_sheepl_bad_host }}\\{{ ludus_sheepl_share }}",
          "dir \\\\{{ ludus_sheepl_bad_host }}\\data",
          "ping -n 2 {{ ludus_sheepl_bad_host }}",
          "net use \\\\{{ ludus_sheepl_fileserver }}\\{{ ludus_sheepl_share }}"
        ]
      }
    ]
  }
}
